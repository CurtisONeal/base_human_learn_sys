# System Configuration (auto-detect or manual override)
SYSTEM_ARCH=auto              # auto | x86_64 | arm64 | apple_silicon
SYSTEM_OS=auto                # auto | macos | windows | linux

# File Management
AUDIO_ARCHIVE_DIR=~/Downloads # Archive location for audio files
AUDIO_DEFAULT_ACTION=prompt   # prompt | delete | archive
KEEP_TRANSCRIPTS=false        # Delete transcripts after summarization

# Captions-first Configuration
# When a source ships a HUMAN-AUTHORED caption track, use it and skip both the
# audio download and the Whisper run. Machine `automatic_captions` are never
# used — they are ASR without our vocabulary hint, so Whisper is better.
CAPTIONS_FIRST=true
# Minimum real words a caption track must yield to be trusted. Music videos
# return cues that are entirely "[♪♪♪]"; below this we fall back to Whisper.
CAPTIONS_MIN_WORDS=20
# Ordered caption language preference, e.g. "en,ja" or "ja,any". The token
# "any" accepts whatever manual track the source ships — useful for a mixed
# library (e.g. Japanese instructional video on an English-configured install).
# Empty falls back to FW_LANG. CJK is counted by character, not by word.
CAPTIONS_LANG=

# When yt-dlp cannot handle a URL at all, fetch the page once and probe any
# embedded video URLs found in it. Covers course pages, docs and blogs whose
# player is injected by JavaScript (yt-dlp's generic extractor only sees markup
# present in the served HTML). Never logs in, runs no JavaScript, and defeats no
# access control — an anonymous fetch either exposes embeds or yields nothing.
SCRAPE_PAGE_EMBEDS=true

# Put all of a playlist's notes in one directory named after the playlist,
# instead of scattering them by date across the output root. Also available as
# --group-by-playlist. Off by default so existing layouts don't move.
GROUP_BY_PLAYLIST=false
# Prefix directories that produced no usable notes with "no_summary_", so a
# silent/blank result is visible in a listing instead of looking like a real one.
MARK_EMPTY_RESULTS=true

# Subject domains — which summarizer prompt to use. YAML here, dict in code.
# Precedence: --domain > DOMAIN_SOURCE_MAP > metadata/transcript vocabulary > generic.
# `generic` is ADR-035's domain-adaptive prompt and stays the default: selection
# supersedes self-detection only where there is evidence.
# DOMAIN_LIBRARY='
# aikido:
#   why: "reasoned, not measured"
#   prompt: aikido.md
#   detect_terms: [uke, nage, tenkan, dojo, shihonage]
# '
DOMAIN_LIBRARY=
DOMAIN_SOURCE_MAP=
DEFAULT_DOMAIN=generic
DOMAIN_PROBE=true

# Burned-in subtitles (Shorts autoplay muted, so captions are baked into pixels).
# OCR overlapping the transcript this much is treated as subtitles, not content —
# otherwise a wordless clip classifies as text-rich on its own captions.
SUBTITLE_OVERLAP=0.6

# Content-shape profiles. Precedence: --profile > source map > probe > globals.
# Profiles: animated | lecture | screencast | slides | talking_head
# Extend the map without touching code — add Udemy/DataCamp/etc. as they are
# characterised. First match wins.
PROFILE_SOURCE_MAP=3blue1brown=animated,postman=screencast,karpathy=lecture,freecodecamp=screencast,khan=lecture
# The probe classifies by OCR yield on frames already extracted (free). It only
# changes what QUALIFIES for the vision model — never your VLM_MAX_FRAMES budget,
# and never extraction thresholds (it would have to re-extract to act on a guess).
PROFILE_PROBE=true
PROFILE_PROBE_MIN_SAMPLES=3
PROFILE_PROBE_DENSE_WORDS=60
PROFILE_PROBE_SPARSE_WORDS=20

# Visual Content Extraction (OFF by default — the vision tier costs money)
# Samples keyframes at scene changes, reads them with local OCR, and escalates
# only the frames OCR cannot explain to a vision model.
EXTRACT_FRAMES=false
# ffmpeg scene sensitivity (0-1). 0.3 suits hard slide cuts; 0.15 is the default
# because continuous animation has no hard cuts (0.3 gave 2 frames for a 19-min
# animated explainer; 0.15 gave 24 after de-duplication).
FRAME_SCENE_THRESHOLD=0.15
FRAME_MAX=40
# When scene detection finds fewer than this, fall back to sampling at fixed
# intervals. Continuously-animated video has no hard cuts, so scene detection
# can miss content that is plainly on screen (measured: 1 frame vs 8).
FRAME_MIN_BEFORE_INTERVAL=4
FRAME_INTERVAL_TARGET=10      # frames to aim for when interval sampling
FRAME_DEDUPE_THRESHOLD=6      # perceptual-hash distance; higher = more merging
FRAME_VIDEO_HEIGHT=720

# Local OCR is macOS-only (Vision framework, via the `ocr` extra). On other
# platforms this degrades to vision-model-only, which is METERED SPEND per
# frame — see "Visual content" in readme.md.
OCR_BACKEND=auto              # auto | none
OCR_MIN_CONFIDENCE=0.4

# Vision tier. Cannot use the claude-cli subscription (Read is disabled there as
# the prompt-injection guard), so this is always metered API spend.
VLM_ENABLED=true
# anthropic/claude-opus-4-8 for depth, anthropic/claude-haiku-4-5 for ~15x less.
VLM_MODEL=anthropic/claude-opus-4-8
VLM_ESCALATE_BELOW_WORDS=12   # frames with less OCR text than this escalate
VLM_MAX_FRAMES=15             # hard per-video ceiling on escalations

# Which eligible frames the budget is spent on. All three signals are free.
# Without ranking the budget goes to whichever frames come first, which on
# real content means a cluster of near-identical transitions in the intro.
RANK_WEIGHT_DWELL=0.45        # how long the frame stayed on screen
RANK_WEIGHT_UNIQUENESS=0.30   # perceptual distance from other frames
RANK_WEIGHT_AUDIO_CUE=0.25    # speaker said "as you can see here" nearby
RANK_CUE_WINDOW=8.0           # seconds either side of the frame
RANK_FINAL_DWELL_CLAMP=1.0    # caps the last frame at the longest observed gap

# faster-whisper Configuration
FW_MODEL=large-v3             # tiny | base | small | medium | large-v3 | distil-large-v3
# Default is large-v3 (multilingual) because this pipeline handles non-English
# material (e.g. Aikido/Japanese terminology) and an English-only model on that
# content produces confident phonetic nonsense.
#
# ASR_AUTO_SELECT (below) switches to distil-large-v3 automatically for quiet,
# English, far-field audio — measured ~2x the words of medium on hard audio, at
# similar speed and size — but only when no non-English signal is detected.
# Setting FW_MODEL to anything else (e.g. "medium" for a quick test) pins it
# and disables auto-select for that run.
ASR_AUTO_SELECT=true          # true | false — auto-pick between large-v3/distil-large-v3
ASR_NOISY_MEAN_DB=-28.0       # audio quieter than this (dBFS) counts as far-field/noisy
                               # calibrated on ONE real sample — treat as a starting point
FW_LANG=en                    # Language code (ISO 639-1)
# Long recordings (> ASR_LONG_THRESHOLD_S, or camera-split groups): windowed ASR, core/longasr.py
ASR_BACKEND=auto              # auto | parakeet-mlx | faster-whisper[:model]
ASR_WINDOW_S=1500             # window length; temp wav never exceeds window + overlap
ASR_OVERLAP_S=8
ASR_LONG_THRESHOLD_S=1200
ASR_MAX_GAP_S=120             # completeness gate: max non-silent untranscribed stretch
ASR_MIN_COVERAGE=0.98
ASR_SILENCE_DB=-40
FW_COMPUTE=auto               # auto | int8 | float16 | int8_float16
FW_BEAM=1                     # Beam size for transcription
FW_VAD=true                   # Enable Voice Activity Detection
FW_CHUNK=30                   # Chunk length in seconds
FW_WORD_TIMESTAMPS=false      # Enable word-level timestamps

# Summarization Configuration  (does NOT affect transcription — that is local
# faster-whisper, configured above. See "Choosing a summarization backend" in
# readme.md before changing this.)
#
# LLM_MODELS is an ordered FAILOVER chain, not a quality ladder: entry 1 does
# essentially all the work; later entries fire only when an earlier one ERRORS.
# Putting a cheap model first makes it your summarizer.
#   claude-cli/<opus|sonnet|haiku>  -> logged-in Claude subscription, no API key
#   openai/… , anthropic/…          -> metered REST, needs the matching key below
#   ollama/… , lm_studio/…          -> local, no key, requires ALLOW_LOCAL_MODELS
LLM_MODELS=["claude-cli/opus", "claude-cli/sonnet", "openai/gpt-4o"]

# Local models need no API key, so without this gate a misconfigured chain could
# silently fall through to a much weaker model. Enable deliberately — e.g. for
# private/NDA content that must not leave the machine.
ALLOW_LOCAL_MODELS=false

# What to do when the subscription runs out of capacity mid-run.
#   wait    -> alert, sleep until the limit resets, retry the same video (DEFAULT)
#   metered -> continue on the paid backends in LLM_MODELS
#   local   -> continue on local backends only (needs ALLOW_LOCAL_MODELS)
#   stop    -> stop cleanly; finished videos are kept and skipped on resume
#   ask     -> prompt once, then apply that answer for the rest of the run
# "wait" is the default on purpose: an unattended run (a research agent that
# cannot answer a prompt) must never start spending money simply because nobody
# was there to say no. It waits for capacity you have already paid for.
ON_EXHAUSTION=wait
# Used only when the CLI does not report a reset time in its error output.
EXHAUSTION_WAIT_SECONDS=18000
# Upper bound, so a misparsed reset time cannot park a run for days.
EXHAUSTION_MAX_WAIT_SECONDS=43200

# Continue on METERED entries in LLM_MODELS after the subscription is exhausted,
# without changing ON_EXHAUSTION (never overrides ON_EXHAUSTION=local). Still
# bounded by the spend caps below; once those are spent, ON_EXHAUSTION applies.
ALLOW_METERED_FALLBACK=false

# Spend caps — checked BEFORE every metered call against a persistent ledger,
# using a worst-case estimate (prompt tokens + METERED_MAX_OUTPUT_TOKENS).
# A capped provider is skipped (e.g. openai -> nous); when all are capped the
# run stops cleanly. claude-cli/ subscription calls are logged at $0, never capped.
METERED_USD_CAP=10.0                 # all metered providers combined, USD
# Optional per-provider caps (JSON). Keys are ledger provider names:
# openai, anthropic, nous (hermes/ entries bill to HERMES_PROXY_PROVIDER).
# PROVIDER_USD_CAPS={"openai": 10, "nous": 5}
METERED_MAX_OUTPUT_TOKENS=16000      # sent as max_tokens, so the estimate is a bound
# Delete or re-point to start a fresh budget. Default (unset) is
# <repo>/previous_run_results/_cost_ledger.json; a relative path here would
# resolve against the current directory, so use an absolute one.
# COST_LEDGER_PATH=/absolute/path/to/_cost_ledger.json
# RUN_ID=                            # optional; default is one id per process

# Nous inference API (OpenAI-compatible), for chain entries "nous/<model>":
#   LLM_MODELS=["claude-cli/opus", "openai/gpt-4o", "nous/Hermes-4-405B"]
NOUS_API_BASE=https://inference-api.nousresearch.com/v1
NOUS_API_KEY=your_key_here

# Local Hermes subscription proxy, for chain entries "hermes/<model>":
#   LLM_MODELS=["claude-cli/opus", "openai/gpt-4o", "hermes/Hermes-4-70B"]
# Start it yourself in another terminal:  hermes proxy start   (provider nous,
# 127.0.0.1:8645 by default; needs a valid `hermes portal` login). It accepts any
# bearer token and attaches the real OAuth credential, so no key is set here.
HERMES_PROXY_BASE=http://127.0.0.1:8645/v1
HERMES_PROXY_PROVIDER=nous           # ledger/cap name for hermes/ entries

# Subscription CLI backend
CLAUDE_CLI_PATH=claude        # resolved on PATH if left bare
CLAUDE_CLI_TIMEOUT=900        # seconds; a long transcript is a big prompt
# `claude -p` is an AGENT, not a completion endpoint. Transcripts are untrusted
# third-party content, so tools stay disabled. Do not empty this.
CLAUDE_CLI_DISALLOWED_TOOLS=Skill,WebSearch,WebFetch,Read,Bash,Glob,Grep,Task,Agent,Edit,Write

# API Keys (metered cloud entries only — not needed for claude-cli/ or local)
OPENAI_API_KEY=your_key_here
ANTHROPIC_API_KEY=your_key_here

# Local LLM server (used when ALLOW_LOCAL_MODELS=true)
OLLAMA_HOST=http://localhost:11434

# Deprecated: superseded by LLM_MODELS. Retained so existing .env files and
# docker-compose overrides keep loading without error.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Web UI Configuration
WEB_HOST=localhost
WEB_PORT=8000
WEB_ENABLE=true               # Enable web interface

# Cookie Configuration (yt-dlp)
YT_DLP_BROWSER=chrome         # chrome | firefox | safari